PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-secure-random-secret"
CLIENT_ORIGIN="http://localhost:5173"

# AI Provider Configuration: 'demo' (default deterministic rule engine), 'openai', 'anthropic', or 'gemini'
AI_PROVIDER=demo

# External AI Provider Keys (Optional: when provided and AI_PROVIDER is set accordingly, real LLM calls are executed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Workspace Demo Settings
DEFAULT_WORKSPACE_NAME="NovaTech Global"
DEFAULT_WORKSPACE_SLUG="novatech"
